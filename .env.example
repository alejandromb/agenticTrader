# Identify the application owner when accessing SEC EDGAR.
# Use a real contact value locally; never commit it.
SEC_USER_AGENT=AgenticTrading/0.1 contact@example.org

# OpenAI credentials remain local runtime secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-2026-03-05

# Read-only Alpaca market-data credentials. Agentic Trading does not initialize
# a trading client and must never submit orders with these values.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
